# Frontend (Vite). Written to .env.local automatically by `npx convex dev`.
VITE_CONVEX_URL=https://<your-deployment>.convex.cloud

# Backend secrets are NOT set here. Set them in Convex (never in the client):
#   npx convex env set MODEL_API_KEY <your Meta Model API key>
#   npx convex env set META_MODEL muse-spark-1.3          # optional
#   npx convex env set META_API_BASE https://api.meta.ai/v1  # optional
#   npx convex env set META_REASONING_EFFORT medium       # optional
#   npx convex env set DAILY_RUN_CAP 60                   # optional
